{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"formatter": { "indentStyle": "tab", "lineWidth": 120 },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": { "noImportantStyles": "off" },
			"style": { "noDescendingSpecificity": "off" }
		}
	},
	"files": { "includes": ["src/**", "api/**", "scripts/**", "e2e/**", "*.ts", "*.json", "!out", "!dist"] }
}

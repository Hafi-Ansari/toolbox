{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "vite",
	"rewrites": [{ "source": "/((?!assets/|api/).*)", "destination": "/index.html" }],
	"headers": [
		{
			"source": "/assets/(.*)",
			"headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
		},
		{
			"source": "/ft-sw.js",
			"headers": [{ "key": "Cache-Control", "value": "no-cache" }]
		}
	]
}
